{
  "name": "mm2026-tournament-prediction-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --run build:server && concurrently \"node --watch dist/server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "vitest run && tsc -p tsconfig.server.json && node --test dist/test-db/db-node-test.js",
    "seed": "npm run seed:tournament-data",
    "seed:tournament-data": "node --run build:server && node dist/server/seed-cli.js",
    "db:migrate": "node --run build:server && node dist/server/migrate-cli.js",
    "reset:dev": "node --run build:server && node dist/server/reset-dev-cli.js --confirm=DELETE_LOCAL_DATA",
    "backup:db": "node --run build:server && node dist/server/backup-cli.js",
    "validate:tournament-data": "node scripts/validate-tournament-data.mjs",
    "audit:tournament-data": "node scripts/audit-tournament-data.mjs",
    "import:excel-seeds": "node --run build:server && node dist/tools/importExcelSeeds.js",
    "validate:prediction-seeds": "node --run build:server && node dist/tools/validatePredictionSeeds.js",
    "validate:provider-match-map": "node --run build:server && node dist/tools/validateProviderMatchMap.js",
    "api-football:discover": "node --run build:server && node dist/tools/discoverApiFootball.js",
    "simulate:reset": "node --run build:server && node dist/tools/simulateReset.js",
    "simulate:matchday1": "node --run build:server && node dist/tools/simulateMatchday1.js",
    "simulate:matchday1:disagreement": "node --run build:server && node dist/tools/simulateMatchday1.js --scenario=disagreement",
    "results:confirm": "node --run build:server && node dist/tools/confirmResult.js",
    "ping:render": "node scripts/ping-render.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "flag-icons": "^7.5.0",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.20"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "xlsx": "^0.18.5"
  }
}
