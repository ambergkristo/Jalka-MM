APP_ENV=local
PUBLIC_APP_BASE_URL=http://localhost:5174

# Result provider defaults stay mock-safe. Sportmonks adapter exists but needs credentials and confirmed fixture mapping.
RESULTS_PROVIDER=mock
# Use dry-run with real provider credentials to inspect provider responses without writing DB changes.
RESULTS_WRITE_MODE=mock
# Single-provider fallback confirmation delay. Two-provider agreement can confirm immediately.
RESULT_CONFIRMATION_DELAY_MINUTES=10
