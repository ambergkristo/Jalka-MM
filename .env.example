APP_ENV=local
PUBLIC_APP_BASE_URL=http://localhost:5174

# Result provider defaults stay mock-safe. Real providers need credentials and confirmed fixture mapping.
RESULTS_PROVIDER=mock
RESULTS_PROVIDER_CHAIN=mock
# Use dry-run with real provider credentials to inspect provider responses without writing DB changes.
RESULTS_WRITE_MODE=mock
# Single-provider fallback confirmation delay. Two-provider agreement can confirm immediately.
RESULT_CONFIRMATION_DELAY_MINUTES=10

# API-Football / API-Sports candidate primary provider.
# API_FOOTBALL_API_KEY=
# API_FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
# API_FOOTBALL_HOST=v3.football.api-sports.io
# API_FOOTBALL_COMPETITION_ID=world-cup
# API_FOOTBALL_SEASON=2026

# football-data.org candidate secondary verifier.
# FOOTBALL_DATA_API_KEY=
# FOOTBALL_DATA_API_BASE_URL=https://api.football-data.org/v4
# FOOTBALL_DATA_COMPETITION_ID=WC
# FOOTBALL_DATA_SEASON=2026

# Sportmonks remains optional paid/premium provider.
# SPORTMONKS_API_KEY=
# SPORTMONKS_API_BASE_URL=https://api.sportmonks.com
# SPORTMONKS_COMPETITION_ID=732
# SPORTMONKS_SEASON=2026

# Backward-compatible generic provider envs can still be used by the selected single provider.
# RESULTS_API_KEY=
# RESULTS_API_BASE_URL=
# RESULTS_COMPETITION_ID=
# RESULTS_SEASON=

# RESULTS_AGENT_SECRET=
